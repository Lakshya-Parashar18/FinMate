# Node.js Port Configuration (defaults to 5000)
PORT=5000

# Environment mode (development / production)
NODE_ENV=development

# MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Auth Secret Key (long random string)
JWT_SECRET=<generate-a-long-random-string>

# Express Session Secret Key
SESSION_SECRET=<generate-a-long-random-string>

# Google OAuth Client ID
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# Frontend URL (for CORS allowance)
FRONTEND_URL=http://localhost:5173

# Unified FastAPI AI Service URL (e.g. on Railway, http://localhost:8000 locally)
AI_SERVICE_URL=http://localhost:8000

# Cloudflare Turnstile Secret Key (Testing Key - Always Passes)
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000OK

# Email Service SMTP Configuration
EMAIL_USER=<your-gmail-address>
EMAIL_PASS=<your-gmail-app-password>

# SMS Authentication twilio Configuration
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=<your-twilio-phone-number>

# AI/LLM API Keys (used for financial insights and analytics)
GEMINI_API_KEY=<your-google-gemini-api-key>
GROQ_API_KEY=<your-groq-api-key>
