# =============================================================================
# FinMate AI Service — Environment Variables
# Copy this file to .env and fill in your values.
# In production (Docker/Railway), inject these as environment variables.
# =============================================================================

# --- Database ---
# MongoDB connection URI (required — service will refuse to start without this)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# --- Service ---
# Port for the FastAPI AI service to listen on (default: 8000)
PORT=8000

# Environment mode: development | production
ENVIRONMENT=development

# Git commit SHA — injected automatically in Docker builds; set manually if needed
# COMMIT_SHA=

# --- Cross-service ---
# URL of this AI service, used by the Node.js server to connect to it.
# Keep this here as documentation; set AI_SERVICE_URL in server/.env too.
AI_SERVICE_URL=http://localhost:8000
